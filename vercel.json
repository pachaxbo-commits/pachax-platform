{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/studio/(.*)", "destination": "/studio.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/demo/(.*)", "destination": "/demo.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
