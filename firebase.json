{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": { "rules": "firebase/storage.rules" },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "storage": { "port": 9295, "host": "127.0.0.1" },
    "auth": {
      "port": 9195,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8185,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4100,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5101,
      "host": "127.0.0.1"
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "pachax",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
