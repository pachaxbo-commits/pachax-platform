    function tPlatform() {
      return request.auth != null && exists(/databases/$(database)/documents/platformOperators/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformOperators/$(request.auth.uid)).data.active == true;
    }
    function tMemberData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data;
    }
    function tIsActiveMember(tenantId) {
      return request.auth != null && !tPlatform()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && tMemberData(tenantId).status == 'active';
    }
    function tHasRole(tenantId, roles) {
      return tIsActiveMember(tenantId) && (tMemberData(tenantId).roleId in roles || (tMemberData(tenantId).roleId == 'owner' && 'admin' in roles));
    }
    function tPermission(tenantId, permission, capability) {
      return tIsActiveMember(tenantId)
        && (get(/databases/$(database)/documents/tenants/$(tenantId)/roles/$(tMemberData(tenantId).roleId)).data.permissions.hasAny([permission])
          || (permission == 'users.manage' && get(/databases/$(database)/documents/tenants/$(tenantId)).data.businessType == 'nightclub_lounge'
            && tMemberData(tenantId).get('nightclubPermissions', []).hasAny(['special.manageUsers'])))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.configuration.features.get(capability, false) == true;
    }
    function tBranch(tenantId, branchId) {
      return tIsActiveMember(tenantId) && branchId in tMemberData(tenantId).branchIds;
    }
    // cashboxIds is a restriction on existing role permissions, not a grant.
    // Missing keeps legacy behavior; an explicit empty list grants no boxes.
    function tNightclubFinancialDocScope(tenantId, data) {
      let member = tMemberData(tenantId);
      return member.roleId in ['owner', 'admin']
        || !('cashboxIds' in member)
        || (data.get('cashboxId', null) is string
          && member.cashboxIds is list
          && data.cashboxId in member.cashboxIds);
    }
    match /tenants/{tenantId} {
      allow get: if tIsActiveMember(tenantId);
      allow list, write: if false;
    }
    match /tenants/{tenantId}/members/{uid} {
      allow get: if tIsActiveMember(tenantId) && (request.auth.uid == uid || tPermission(tenantId,'users.manage','users') || tHasRole(tenantId,['warehouse']));
      allow list: if tPermission(tenantId,'users.manage','users') || tHasRole(tenantId,['warehouse']);
      allow write: if false;
    }
    match /tenants/{tenantId}/roles/{roleId} { allow read: if tIsActiveMember(tenantId); allow write: if false; }
    match /tenants/{tenantId}/branches/{branchId} { allow read: if tBranch(tenantId,branchId); allow write: if false; }
    match /tenants/{tenantId}/auditLogs/{eventId} { allow read: if tPermission(tenantId,'settings.manage','settings'); allow write: if false; }
    match /users/{uid}/tenantLinks/{tenantId} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /users/{uid}/onboarding/{document=**} { allow read, write: if false; }
    function isPlatformOperator() {
      return request.auth != null
        && request.auth.token.get('platform', false) == true
        && exists(/databases/$(database)/documents/platformOperators/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformOperators/$(request.auth.uid)).data.active == true;
    }
    function platformOperatorRole() {
      return get(/databases/$(database)/documents/platformOperators/$(request.auth.uid)).data.role;
    }
    function isPlatformOwner() {
      return isPlatformOperator() && (
        request.auth.token.get('platformRole', '') == 'platform_owner' ||
        platformOperatorRole() == 'platform_owner'
      );
    }
    function isPlatformAdminOrOwner() {
      return isPlatformOperator() && (
        request.auth.token.get('platformRole', '') in ['platform_owner', 'platform_admin'] ||
        platformOperatorRole() in ['platform_owner', 'platform_admin']
      );
    }
    function isPlatformContentOrHigher() {
      return isPlatformOperator() && (
        request.auth.token.get('platformRole', '') in ['platform_owner', 'platform_admin', 'platform_content'] ||
        platformOperatorRole() in ['platform_owner', 'platform_admin', 'platform_content']
      );
    }
    match /platformOperators/{uid} {
      allow get: if isPlatformOperator() && (request.auth.uid == uid || isPlatformOwner());
      allow list: if isPlatformOwner();
      allow write: if false;
    }
    match /platformBootstrap/{document=**} { allow read, write: if false; }
    match /supportSessions/{uid} { allow read, write: if false; }
    match /platformAuditLogs/{eventId} {
      allow read: if isPlatformAdminOrOwner();
      allow write: if false;
    }
    match /platformConfig/{configId} {
      allow get: if resource.data.status == 'published' || isPlatformOperator();
      allow list, write: if false;
    }
    match /platformTemplates/{templateId} {
      allow read: if resource.data.status == 'published' || isPlatformOperator();
      allow write: if false;
    }
    match /platformPlans/{planId} {
      allow read: if resource.data.status == 'published' || isPlatformOperator();
      allow write: if false;
    }
    match /platformExtras/{extraId} {
      allow read: if resource.data.status == 'published' || isPlatformOperator();
      allow write: if false;
    }
    match /platformMedia/{assetId} {
      allow read: if resource.data.status == 'published' || isPlatformOperator();
      allow write: if false;
    }
    match /tenants/{tenantId}/products/{productId} {
      allow read: if tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'sales.create','sales') || tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'products.manage','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/sales/{saleId} {
      allow read: if tPermission(tenantId,'sales.read','sales') && tBranch(tenantId,resource.data.branchId);
      allow write: if false;
    }
    match /tenants/{tenantId}/cashSessions/{cashId} {
      allow read: if tPermission(tenantId,'cash.close','cash') && tBranch(tenantId,resource.data.branchId);
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubZones/{zoneId} {
      allow read: if tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'settings.manage','settings');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubTables/{tableId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubAccounts/{accountId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubRounds/{roundId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPayments/{paymentId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubReservations/{reservationId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'orders.read','orders');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPromoters/{promoterId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'settings.manage','settings') || tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'sales.create','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPromoterEvents/{eventId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'settings.manage','settings') || tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'sales.create','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPromoterTicketSales/{saleId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'settings.manage','settings') || tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'sales.create','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPromoterLoungeSales/{saleId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'settings.manage','settings') || tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'sales.create','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubPromoterConsumptions/{consumptionId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'settings.manage','settings') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }

    match /tenants/{tenantId}/nightclubProducts/{productId} {
      allow read: if tPermission(tenantId,'sales.create','sales') || tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'products.manage','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubInventory/{inventoryId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubInventoryMovements/{movementId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubLocations/{locationId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCashboxes/{cashboxId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'inventory.read','inventory') || tPermission(tenantId,'cash.close','cash'));
      allow write: if false;
    }
    // An operator can read only their own server-written context. This document
    // is the source of truth for product cashbox, location and active shift.
    match /tenants/{tenantId}/nightclubOperatorContexts/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && tBranch(tenantId, resource.data.branchId);
      allow list, write: if false;
    }
    match /tenants/{tenantId}/nightclubInventoryBalances/{balanceId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubInventoryLots/{lotId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubOpenBottles/{bottleId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubTransfers/{transferId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tPermission(tenantId,'inventory.read','inventory');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCustomers/{customerId} {
      allow read: if tPermission(tenantId,'customers.read','customers');
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCustomerIncidents/{incidentId} {
      allow read: if tHasRole(tenantId,['admin']) && tBranch(tenantId,resource.data.branchId);
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubMembers/{memberId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'customers.read','customers') || tPermission(tenantId,'orders.read','orders'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCourtesies/{courtesyId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCommissions/{commissionId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'sales.read','sales') || tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCommissionPayments/{paymentId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubShifts/{shiftId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubCashMovements/{movementId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && tNightclubFinancialDocScope(tenantId,resource.data) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubOperationalState/{branchId} {
      allow read: if tBranch(tenantId,branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash'));
      allow write: if false;
    }
    match /tenants/{tenantId}/nightclubOperations/{operationId} {
      allow get: if tIsActiveMember(tenantId) && resource.data.actorUid == request.auth.uid;
      allow list, write: if false;
    }
    match /tenants/{tenantId}/nightclubAudit/{eventId} {
      allow read: if tPermission(tenantId,'settings.manage','settings');
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantSectors/{sectorId} {
      allow read: if tBranch(tenantId,resource.data.branchId) &&
        (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'sales.create','sales') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantTables/{tableId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'sales.create','sales') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantOrders/{orderId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantPayments/{paymentId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'sales.read','sales'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantShifts/{shiftId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantCashMovements/{movementId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'cash.close','cash') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantOperationalState/{branchId} {
      allow read: if tBranch(tenantId,branchId) && (tPermission(tenantId,'orders.read','orders') || tPermission(tenantId,'cash.close','cash'));
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantOperations/{operationId} {
      allow get: if tIsActiveMember(tenantId) && resource.data.actorUid == request.auth.uid;
      allow list, write: if false;
    }
    match /tenants/{tenantId}/restaurantAudit/{eventId} {
      allow read: if tPermission(tenantId,'settings.manage','settings');
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantCustomers/{customerId} {
      allow read: if tPermission(tenantId,'customers.read','customers') || tPermission(tenantId,'customers.manage','customers') || tPermission(tenantId,'settings.manage','settings');
      allow write: if false;
    }
    match /tenants/{tenantId}/restaurantInventoryMovements/{movementId} {
      allow read: if tBranch(tenantId,resource.data.branchId) && (tPermission(tenantId,'inventory.read','inventory') || tPermission(tenantId,'settings.manage','settings'));
      allow write: if false;
    }
